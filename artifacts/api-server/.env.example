# =============================================================================
# Biddi api-server environment configuration
# Copy to .env (or .env.local) and fill in the real values for your environment.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (required) -----------------------------------------------------
# Standard postgres connection string. The Drizzle ORM uses this for all reads/writes.
DATABASE_URL=postgresql://localhost:5432/biddi_dev

# --- Redis / BullMQ (optional) -----------------------------------------------
# When set, scheduled jobs (bidding-offer expiry, etc.) run on BullMQ.
# When unset, the api-server falls back to in-process setInterval timers
# (fine for local dev; not recommended for multi-instance production).
REDIS_URL=

# Set to "true" to disable the bidding-offer + post expiry sweep entirely.
# Vitest sets this so unit tests don't spin up background timers.
BIDDING_EXPIRY_DISABLED=

# --- Auth / Admin ------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme

# --- Maps & geocoding (Google + OSRM only) -----------------------------------
# Google Maps Geocoding/Places API key (server-side use).
GOOGLE_API_KEY=
# Public Maps SDK keys for mobile builds. Both are read at build/runtime for
# Android (com.google.android.geo.API_KEY) and Web (maps-js).
GOOGLE_API_ANDROID_KEY=
GOOGLE_API_WEB_KEY=
# OSRM endpoint used for route geometry + ETAs. Override to point at a self-
# hosted OSRM instance; defaults to the public demo when unset.
OSRM_BASE_URL=https://router.project-osrm.org

# --- Dispatch ----------------------------------------------------------------
# Radius (km) within which a new ride request is dispatched to nearby drivers.
DISPATCH_RADIUS_KM=15
# How often the driver-position cache is persisted to Postgres.
DRIVER_PERSIST_INTERVAL_MS=30000

# --- Object storage ----------------------------------------------------------
# Google Cloud Storage bucket paths. Use object-storage emulator locally.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Stripe (payments + driver Connect payouts) ------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SMS providers -----------------------------------------------------------
# MoroccanSMS (transactional OTP for MA numbers)
MOROCCANSMS_SENDER=
MOROCCANSMS_TOKEN=
# Twilio (fallback / international OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Misc --------------------------------------------------------------------
# OpenWeather API key used by the weather-surcharge polling job. Optional —
# the job no-ops when unset.
OPENWEATHER_API_KEY=
# Override for the currency exchange rates feed; leave blank to use the default.
CURRENCY_RATES_URL=
# Max age (hours) of cached driver positions that are warmed up on boot.
WARM_UP_MAX_AGE_HOURS=24
